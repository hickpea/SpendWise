<%- include('partials/header.ejs',{title:"Home page",css_file:"/css/home.css"}) %>
<% const transactions = dashboard.transactions || []; %>
<% const income = transactions.filter(item => item.type === 'income').reduce((sum, item) => sum + item.amount, 0); %>
<% const expenses = transactions.filter(item => item.type === 'expense').reduce((sum, item) => sum + item.amount, 0); %>
<% const balance = income - expenses; %>
<% const money = value => `$${Number(value || 0).toLocaleString('en-US', { maximumFractionDigits: 0 })}`; %>
<div class="app-shell">
	<header class="topbar">
		<a class="brand" href="/" aria-label="SpendWise home">
			<span class="brand-mark"><i class="fa-solid fa-wallet"></i></span>
			<span>Spend<span>Wise</span></span>
		</a>
		<nav class="main-nav" aria-label="Main navigation">
			<a class="active" href="/">Dashboard</a>
			<a href="#accounts">Accounts <i class="fa-solid fa-chevron-right"></i></a>
			<a href="#reports">Reports <i class="fa-solid fa-chevron-right"></i></a>
			<a href="#settings">Settings</a>
		</nav>
		<div class="profile-actions">
			<button class="icon-button" aria-label="Messages"><i class="fa-regular fa-message"></i></button>
			<span class="avatar">JD</span>
			<button class="chevron-button" aria-label="Open profile menu"><i class="fa-solid fa-caret-down"></i></button>
		</div>
	</header>

	<main>
		<section class="hero-grid">
			<div class="welcome-panel">
				<p class="eyebrow">Good morning, John</p>
				<h1>Take Control of<br>Your Money <strong>Smartly</strong></h1>
				<p class="welcome-copy">Manage your expenses and savings<br>with ease.</p>
				<div class="hero-actions">
					<a class="primary-button" href="#accounts">Get started</a>
					<a class="secondary-button" href="#reports">See overview <i class="fa-solid fa-arrow-right"></i></a>
				</div>
				<div class="trust-row">
					<div class="mini-avatars"><span>AS</span><span>MK</span><span>RL</span></div>
					<span>Trusted by 10,000+<br><b>users</b> like you</span>
				</div>
			</div>

			<div class="dashboard-preview">
				<div class="stat-row">
					<article class="stat-card"><span>Total Balance</span><strong><%= money(balance) %></strong><small><i class="fa-solid fa-arrow-trend-up"></i> Live</small></article>
					<article class="stat-card"><span>Monthly Income</span><strong><%= money(income) %></strong><small><i class="fa-solid fa-arrow-trend-up"></i> Live</small></article>
					<article class="stat-card"><span>Monthly Expenses</span><strong><%= money(expenses) %></strong><small class="down"><i class="fa-solid fa-arrow-trend-down"></i> Live</small></article>
				</div>
				<div class="preview-main">
					<article class="breakdown panel">
						<div class="panel-heading"><h2>Spending Breakdown</h2><button aria-label="More spending options"><i class="fa-solid fa-ellipsis"></i></button></div>
						<div class="breakdown-body">
							<div class="donut"><div>35%<small>Housing</small></div></div>
							<div class="legend"><span><i class="blue"></i>Housing <b>35%</b></span><span><i class="orange"></i>Food <b>20%</b></span><span><i class="yellow"></i>Transport <b>15%</b></span><span><i class="green"></i>Entertainment <b>10%</b></span><span><i class="teal"></i>Other <b>20%</b></span></div>
						</div>
					</article>
					<article class="transactions panel">
						<div class="panel-heading"><h2>Recent Transactions</h2><button data-action="add-transaction" aria-label="Add transaction"><i class="fa-solid fa-plus"></i></button></div>
						<% transactions.slice(0, 4).forEach(item => { %>
							<div class="transaction"><span class="transaction-icon <%= item.type === 'income' ? 'salary' : 'grocery' %>"><i class="fa-solid fa-receipt"></i></span><span><b><%= item.name %></b><small><%= item.category %></small></span><strong class="<%= item.type === 'income' ? 'positive' : 'negative' %>"><%= item.type === 'income' ? '+' : '-' %> <%= money(item.amount) %></strong></div>
						<% }); %>
					</article>
				</div>
				<div class="person-illustration" aria-hidden="true"><span class="hair"></span><span class="head"></span><span class="body"></span><span class="arm"></span><span class="leg one"></span><span class="leg two"></span></div>
			</div>
		</section>

		<section class="summary-grid" id="reports">
			<article class="summary-panel goals" id="accounts"><div class="panel-heading"><h2>Savings Goals</h2><button data-action="add-goal" aria-label="Add savings goal"><i class="fa-solid fa-plus"></i></button></div><% dashboard.goals.forEach(goal => { const percent = Math.min(100, Math.round((goal.saved / goal.target) * 100)); %><div class="goal"><span class="goal-icon <%= goal.color === 'green' ? 'emergency' : 'vacation' %>"><i class="fa-solid fa-bullseye"></i></span><span class="goal-info"><b><%= goal.name %></b><span class="progress"><i style="width:<%= percent %>%"></i></span></span><strong><%= percent %>% <small>to Goal</small></strong></div><% }); %></article>
			<article class="summary-panel expense"><div class="panel-heading"><h2>Expense Overview</h2><select aria-label="Expense period"><option>This Month</option></select></div><div class="bars"><span style="height:<%= income ? 82 : 10 %>%"></span><span style="height:<%= expenses ? Math.max(10, Math.round(expenses / Math.max(income, 1) * 82)) : 10 %>%"></span><span style="height:<%= balance > 0 ? Math.max(10, Math.round(balance / Math.max(income, 1) * 82)) : 10 %>%"></span></div><div class="bar-labels"><b><i class="blue-dot"></i>Income<br><strong><%= money(income) %></strong></b><b><i class="orange-dot"></i>Expenses<br><strong><%= money(expenses) %></strong></b><b><i class="green-dot"></i>Savings<br><strong><%= money(balance) %></strong></b></div></article>
			<article class="summary-panel bills" id="settings"><div class="panel-heading"><h2>Upcoming Bills</h2><button data-action="add-bill" aria-label="Add bill"><i class="fa-solid fa-plus"></i></button></div><% dashboard.bills.forEach(bill => { const date = new Date(bill.dueDate); %><div class="bill"><span class="bill-icon"><i class="fa-solid fa-receipt"></i></span><span><b><%= bill.name %></b><small><%= bill.category %></small></span><strong><%= date.toLocaleString('en-US', { month: 'short' }) %> <b><%= date.getDate() %></b></strong></div><% }); %></article>
		</section>
	</main>
</div>
<script src="/js/dashboard.js" defer></script>
<%- include('partials/footer.ejs') %>
